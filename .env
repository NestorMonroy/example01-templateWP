# Entorno
WP_ENV=development

# Base de datos
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_HOST=127.0.0.1:3306
DB_PREFIX=wp_
DB_CHARSET=utf8mb4
DB_COLLATE=utf8mb4_swedish_ci

# URLs
WP_HOME=http://localhost
WP_SITEURL=${WP_HOME}/wordpress

# Claves de seguridad (genera estas en: https://api.wordpress.org/secret-key/1.1/salt/)
AUTH_KEY='tu-clave-única'
SECURE_AUTH_KEY='tu-clave-única'
LOGGED_IN_KEY='tu-clave-única'
NONCE_KEY='tu-clave-única'
AUTH_SALT='tu-clave-única'
SECURE_AUTH_SALT='tu-clave-única'
LOGGED_IN_SALT='tu-clave-única'
NONCE_SALT='tu-clave-única'

# Container
CONTAINER=local_dev

# Paths
WP_CONTENT_DIR=${WP_HOME}/wp-content
WP_CONTENT_URL=${WP_HOME}/wp-content